# ==========================================
# Termux-DeX Tmux - Minimal & Clean
# Com: Sessionx + Floax + Catppuccin
# ==========================================

# ----------------------------------------
# PREFIXO
# ----------------------------------------
unbind C-b
unbind C-Space
set -g prefix C-a
bind C-a send-prefix
bind C-a last-window

set -g default-terminal "screen-256color"
set -ga terminal-overrides ",*256col*:Tc"
set -sg escape-time 0
set -g mouse on

set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on
setw -g mode-keys vi

set -g detach-on-destroy on
set -g remain-on-exit off

# ----------------------------------------
# BARRA: TOPO LIMPA
# ----------------------------------------
set -g status on
set -g status-position top
set -g status-style "bg=#1e1e2e,fg=#cdd6f4"
set -g status-justify left
set -g status-left-length 100
set -g status-right-length 100

# Esquerda: Ícone Termux + Sessão
set -g status-left "#[bg=#89b4fa,fg=#1e1e2e,bold]  #S #[bg=#1e1e2e,fg=#89b4fa] "
# Centro: Janelas (Catppuccin style)
setw -g window-status-format "#[fg=#45475a] #I #[fg=#6c7086]#W "
setw -g window-status-current-format "#[bg=#313244,fg=#1e1e2e]#[bg=#313244,fg=#89b4fa,bold] #I #[fg=#cdd6f4]#W#{?window_zoomed_flag, 󰁌,} #[bg=#1e1e2e,fg=#313244]"
setw -g window-status-separator ""

# Direita: SÓ HORA (limpa, funciona sempre)
set -g status-right "#[fg=#45475a]│ #[fg=#cba6f7]󰥔 %H:%M "

# Bordas
set -g pane-border-style "fg=#313244"
set -g pane-active-border-style "fg=#89b4fa"

# ----------------------------------------
# ATALHOS BÁSICOS
# ----------------------------------------
bind c new-window -c "#{pane_current_path}"
bind , command-prompt -p "Nome:" "rename-window '%%'"
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5
bind z resize-pane -Z
bind x kill-window
bind X kill-pane
bind o kill-window -a
bind [ copy-mode
bind ] paste-buffer
bind r source-file ~/.tmux.conf \; display "Ok!"

# Copy mode
bind -T copy-mode-vi v send-keys -X begin-selection
bind -T copy-mode-vi y send-keys -X copy-selection-and-cancel
bind -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel "termux-clipboard-set"

# ----------------------------------------
# PLUGINS
# ----------------------------------------
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

# Sessionx
set -g @plugin 'omerxx/tmux-sessionx'
set -g @sessionx-bind 'o'
set -g @sessionx-window-height '85%'
set -g @sessionx-window-width '75%'
set -g @sessionx-zoxide-mode 'on'
set -g @sessionx-preview-location 'right'
set -g @sessionx-preview-enabled 'true'
set -g @sessionx-filter-current 'false'

# Floax
set -g @plugin 'omerxx/tmux-floax'
set -g @floax-bind 'p'
set -g @floax-width '80%'
set -g @floax-height '80%'
set -g @floax-border-color 'magenta'
set -g @floax-text-color 'blue'
set -g @floax-change-path 'true'

# Resurrect/Continuum
set -g @resurrect-capture-pane-contents 'on'
set -g @resurrect-strategy-nvim 'session'
set -g @continuum-restore 'on'

run '~/.tmux/plugins/tpm/tpm'
